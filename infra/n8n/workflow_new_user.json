{
    "name": "New User Welcome",
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "new-user",
                "options": {}
            },
            "name": "Webhook Trigger",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                250,
                300
            ]
        },
        {
            "parameters": {
                "operation": "executeQuery",
                "query": "SELECT * FROM auth.users WHERE email = $1;",
                "additionalFields": {
                    "queryParams": "={{$node[\"Webhook Trigger\"].json[\"body\"][\"email\"]}}"
                }
            },
            "name": "Get User Details",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 1,
            "position": [
                450,
                300
            ],
            "credentials": {
                "postgres": {
                    "id": "postgresCredentials",
                    "name": "Supabase Postgres"
                }
            }
        },
        {
            "parameters": {
                "fromEmail": "welcome@outuolu.com",
                "toEmail": "={{$node[\"Webhook Trigger\"].json[\"body\"][\"email\"]}}",
                "subject": "Welcome to OuTuoLu!",
                "text": "Hi there! Welcome to the community. Start planning your trip now!"
            },
            "name": "Send Welcome Email",
            "type": "n8n-nodes-base.emailSend",
            "typeVersion": 1,
            "position": [
                650,
                300
            ],
            "credentials": {
                "smtp": {
                    "id": "smtpCredentials",
                    "name": "SMTP Server"
                }
            }
        }
    ],
    "connections": {
        "Webhook Trigger": {
            "main": [
                [
                    {
                        "node": "Get User Details",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Get User Details": {
            "main": [
                [
                    {
                        "node": "Send Welcome Email",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}