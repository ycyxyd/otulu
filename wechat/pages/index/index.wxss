/* pages/index/index.wxss */
.container {
  padding: 20rpx;
  background-color: #f8f8f8;
  min-height: 100vh;
}

.header {
  padding: 40rpx 0;
  text-align: center;
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #2c3e50;
}

.subtitle {
  display: block;
  font-size: 24rpx;
  color: #7f8c8d;
  margin-top: 10rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
  border-left: 8rpx solid #3498db;
}

.news-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.news-item {
  background-color: #fff;
  padding: 30rpx;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 2rpx 5rpx rgba(0,0,0,0.05);
}

.news-tag {
  align-self: flex-start;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  color: #fff;
  margin-bottom: 16rpx;
}

.tag-red {
  background-color: #e74c3c;
}

.tag-green {
  background-color: #2ecc71;
}

.news-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 8rpx;
}

.news-summary {
  font-size: 26rpx;
  color: #7f8c8d;
  line-height: 1.4;
}

.loading {
  text-align: center;
  padding: 40rpx;
  color: #95a5a6;
}
