<!--pages/index/index.wxml-->
<view class="container">
  <view class="header">
    <text class="title">欧途路 OuTuoLu</text>
    <text class="subtitle">发现欧洲，随心所欲</text>
  </view>

  <view class="section-title">最新资讯 & 路线</view>

  <block wx:if="{{loading}}">
    <view class="loading">加载中...</view>
  </block>
  
  <block wx:else>
    <view class="news-list">
      <block wx:for="{{newsList}}" wx:key="id">
        <view class="news-item" bindtap="onTapNews" data-id="{{item.id}}">
          <view class="news-tag {{item.type === 'NEWS' ? 'tag-red' : 'tag-green'}}">{{item.type}}</view>
          <view class="news-content">
            <view class="news-title">{{item.title}}</view>
            <view class="news-summary">{{item.summary}}</view>
          </view>
        </view>
      </block>
    </view>
  </block>
</view>
